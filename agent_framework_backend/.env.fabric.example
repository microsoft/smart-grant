# =============================================================================
# Microsoft Fabric Integration Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Or set these as environment variables in Azure Container Apps
# =============================================================================

# -----------------------------------------------------------------------------
# Azure Active Directory Configuration
# Required for authenticating with Microsoft Fabric APIs
# -----------------------------------------------------------------------------
FABRIC_TENANT_ID=your-azure-tenant-id
FABRIC_CLIENT_ID=your-app-registration-client-id
FABRIC_CLIENT_SECRET=your-client-secret

# -----------------------------------------------------------------------------
# Microsoft Fabric Workspace Configuration
# These are created automatically by the deployment script
# Or can be obtained from the Fabric portal
# -----------------------------------------------------------------------------
FABRIC_WORKSPACE_ID=your-fabric-workspace-guid
FABRIC_LAKEHOUSE_ID=your-lakehouse-guid
FABRIC_WORKSPACE_NAME=SmartGrantWorkspace

# -----------------------------------------------------------------------------
# Power BI Configuration
# Configure embedded Power BI reports for the Analytics dashboard
# -----------------------------------------------------------------------------
# The ID of the Power BI report to embed in the Analytics page
POWERBI_REPORT_ID=your-powerbi-report-guid

# Optional: Power BI Dashboard ID for dashboard view
POWERBI_DASHBOARD_ID=your-powerbi-dashboard-guid

# Optional: Group ID (workspace ID in Power BI terms)
# Usually same as FABRIC_WORKSPACE_ID for Fabric workspaces
POWERBI_GROUP_ID=your-powerbi-group-guid

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable/disable Fabric integration
FABRIC_ENABLED=true

# Enable Power BI embedded analytics (if false, uses local charts)
POWERBI_EMBEDDED_ENABLED=true

# Enable real-time analytics tracking to OneLake
ANALYTICS_TRACKING_ENABLED=true

# -----------------------------------------------------------------------------
# OneLake Configuration
# -----------------------------------------------------------------------------
# Tables to sync data to OneLake
ONELAKE_TABLES=grant_applications,schools,agents_performance,analytics_events

# Data refresh interval in minutes
ONELAKE_SYNC_INTERVAL=5

# =============================================================================
# How to obtain these values:
# =============================================================================
#
# 1. FABRIC_TENANT_ID:
#    - Azure Portal > Azure Active Directory > Overview > Tenant ID
#
# 2. FABRIC_CLIENT_ID & FABRIC_CLIENT_SECRET:
#    - Azure Portal > App Registrations > Create new registration
#    - Add API Permissions: Power BI Service (Delegated & Application)
#    - Add API Permissions: Microsoft Fabric (if available)
#    - Create a client secret under Certificates & secrets
#
# 3. FABRIC_WORKSPACE_ID:
#    - Created by deployment script OR
#    - Microsoft Fabric portal > Your workspace > URL contains workspace ID
#
# 4. FABRIC_LAKEHOUSE_ID:
#    - Created by deployment script OR
#    - Fabric portal > Lakehouse > Settings > Lakehouse ID
#
# 5. POWERBI_REPORT_ID:
#    - Power BI portal > Your report > URL contains report ID
#    - Or create a report in Fabric workspace using Lakehouse data
#
# =============================================================================
