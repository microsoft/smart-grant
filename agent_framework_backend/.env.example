# ============================================================================
# Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================================

# Azure OpenAI Configuration
# Your Azure OpenAI resource endpoint
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Your Azure OpenAI API key
AZURE_OPENAI_API_KEY=your-api-key-here

# Your Azure OpenAI deployment name (default: gpt-4o-mini)
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Azure OpenAI API version (default: 2024-02-15-preview)
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Grants.gov API Configuration
# Optional. The primary Grants.gov search2 API needs no key; this only enables
# the legacy GSA Search.gov fallback index.
# NOTE: the variable name must match the Settings field (gsa_search_api_key).
GSA_SEARCH_API_KEY=

# Application Settings
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Cache TTL in seconds (default: 900 = 15 minutes)
CACHE_TTL_SECONDS=900
