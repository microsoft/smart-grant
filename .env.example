# ============================================================================
# Smart Grant Request - Environment Configuration
# ============================================================================
# 
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control
#

# =============================================================================
# Agent Framework Backend
# =============================================================================

# URL of the Python Agent Framework backend
NEXT_PUBLIC_AGENT_FRAMEWORK_URL=http://localhost:8000

# Internal proxy URL (for server-side requests)
AGENT_FRAMEWORK_URL=http://localhost:8000

# =============================================================================
# Application Settings
# =============================================================================

# Environment: development | production
NODE_ENV=development

# Enable debug logging
NEXT_PUBLIC_DEBUG=true

# =============================================================================
# v2 — Azure AI Foundry (primary, GPT-5.4)
# Endpoint shape: https://<project>.cognitiveservices.azure.com/
# Auth: API key (do NOT commit). Store the key in Azure Key Vault and surface
# it to Container Apps as a secret. For local dev, place it in .env.local only.
# =============================================================================
FOUNDRY_ENDPOINT=https://<your-foundry-resource>.cognitiveservices.azure.com/
# Required for the Responses API used by the Agent Framework SDK.
FOUNDRY_API_VERSION=2025-03-01-preview
# When true, authenticate with Microsoft Entra ID (DefaultAzureCredential).
# Required for Foundry resources where key-based auth is disabled.
# When false, the backend falls back to FOUNDRY_API_KEY.
FOUNDRY_USE_AAD=true
# Real key lives ONLY in .env.local (local dev) and Azure Key Vault (cloud).
# Leave blank when FOUNDRY_USE_AAD=true.
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT_GPT_5_4=gpt-5.4
# Optional secondary deployments on the same Foundry resource:
FOUNDRY_DEPLOYMENT_GPT_5_MINI=
FOUNDRY_DEPLOYMENT_GPT_4O=

# =============================================================================
# v2 — Legacy Azure OpenAI (optional fallback; leave blank to disable)
# =============================================================================
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_KEY=

# =============================================================================
# v2 — Per-agent model routing
# Values: foundry-gpt-5.4 | foundry-gpt-5-mini | foundry-gpt-4o |
#         azure-openai-gpt-4o | azure-openai-gpt-4o-mini
# Default: every agent uses GPT-5.4 (best quality across the pipeline).
# Override per-agent to trade quality for cost/latency.
# =============================================================================
AGENT_MODEL_DISCOVERY=foundry-gpt-5.4
AGENT_MODEL_NARRATIVE=foundry-gpt-5.4
AGENT_MODEL_BUDGET=foundry-gpt-5.4
AGENT_MODEL_COMPLIANCE=foundry-gpt-5.4
AGENT_MODEL_INTELLIGENCE=foundry-gpt-5.4
AGENT_MODEL_WRITER=foundry-gpt-5.4

# =============================================================================
# v2 — Pulse (uso do portal)
# Log append-only de eventos, um blob JSON Lines por dia.
# Em produção a autenticação é exclusivamente por Entra ID: a identidade do
# backend precisa do papel "Storage Blob Data Contributor" na conta. As contas
# provisionadas por infra/foundation.bicep têm allowSharedKeyAccess=false, ou
# seja, chave compartilhada não funciona nem que alguém tente.
# Em branco, o Pulse fica desligado e o painel declara que não está gravando —
# nada é inventado para preencher o espaço.
# =============================================================================
PULSE_STORAGE_ACCOUNT_URL=
PULSE_STORAGE_CONTAINER=pulse

# Só para desenvolvimento local. O emulador Azurite não fala Entra ID, então
# esta é a única forma de rodar o Pulse na sua máquina sem uma conta no Azure:
#   npx --yes -p azurite azurite-blob --location ./.azurite --blobPort 10000
#   PULSE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# Só é consultada quando PULSE_STORAGE_ACCOUNT_URL está em branco — uma
# variável esquecida no ambiente não consegue rebaixar a autenticação de uma
# instalação real. Nunca aponte para uma conta de produção.
PULSE_STORAGE_CONNECTION_STRING=

# =============================================================================
# v2 — Auth (signed cookie session)
# =============================================================================
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# =============================================================================
# v2 — Observability (OpenTelemetry)
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=smart-grant-request
